{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npm list *)",
      "Bash(napi-postinstall unrs-resolver *)",
      "Bash(export PATH=\"$DIR/node_modules/.bin:$PATH\")",
      "Bash($DIR/node_modules/.bin/napi-postinstall unrs-resolver *)",
      "Bash(timeout 15 npm run dev)",
      "Bash(npm run *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "Bash(node_modules/.bin/next dev *)",
      "Bash(pkill -f \"next dev\")",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
